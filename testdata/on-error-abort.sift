// Demonstrates the default error policy: a failing check stops the
// whole run. Tom is dropped by filter
// (age 15); Grace's blank email fails check and aborts the run right
// there — Liam is never even read. Only Ada's row, written before the
// failure, reaches the sink.
source in  = csv("on-error-abort.csv", schema: { name: string, age: int, email: string })
sink   out = jsonl("on-error-abort_out.jsonl")

pipeline main {
  in |> filter(.age >= 18) |> check(.email != "", "missing email") |> out
}
