// Demonstrates conditional routing: one masked
// stream, pulled once, but each row goes to exactly one sink chosen by
// a predicate over region -- unlike broadcast, never more than one
// write per row. else is mandatory (it's what makes route total), and
// here it catches every region besides EU/US.
source in        = csv("routing.csv", schema: { name: string, email: string @pii, region: string })
sink   eu_sink   = jsonl("routing_out.jsonl")
sink   us_sink   = jsonl("routing_us.jsonl")
sink   rest_sink = jsonl("routing_rest.jsonl")

pipeline main {
  in
    |> map({ ...row, email: mask(.email) })
    |> route {
         .region == "EU" => eu_sink,
         .region == "US" => us_sink,
         else            => rest_sink,
       }
}
